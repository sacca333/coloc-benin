# ── Fichier .env pour docker-compose ─────────────────────────────────────────
# Copiez ce fichier en .env et renseignez les valeurs réelles

# Base de données
POSTGRES_PASSWORD=un_mot_de_passe_fort_ici

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_jwt_secret_tres_long_et_aleatoire

# URLs de l'application
FRONTEND_URL=https://colocbenin.bj
BACKEND_URL=https://api.colocbenin.bj
NEXT_PUBLIC_API_URL=https://api.colocbenin.bj/api

# Email SMTP (exemple Brevo / Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_smtp_password
EMAIL_FROM="ColocBénin <no-reply@colocbenin.bj>"

# MTN MoMo Bénin
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox

# C'cash (Celtiis Bénin)
CCASH_BASE_URL=https://api.ccash.bj
CCASH_API_KEY=
CCASH_MERCHANT_ID=

# Moov Money Bénin
MOOV_BASE_URL=https://api.moov.bj
MOOV_API_KEY=
MOOV_MERCHANT_CODE=

# Webhook — générer avec : openssl rand -hex 32
WEBHOOK_SECRET=votre_webhook_secret
