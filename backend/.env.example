# Serveur
PORT=4000
NODE_ENV=development

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/coloc_benin"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@colocbenin.bj
SMTP_PASS=your_smtp_password
EMAIL_FROM="ColocBénin <no-reply@colocbenin.bj>"

# Frontend URL (pour les liens de validation email)
FRONTEND_URL=http://localhost:3000

# Upload fichiers
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# MTN MoMo
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=your_momo_subscription_key
MOMO_API_USER=your_momo_api_user
MOMO_API_KEY=your_momo_api_key
MOMO_TARGET_ENV=sandbox

# C'cash (Celtiis)
CCASH_BASE_URL=https://api.ccash.bj
CCASH_API_KEY=your_ccash_api_key
CCASH_MERCHANT_ID=your_merchant_id

# Moov Money
MOOV_BASE_URL=https://api.moov.bj
MOOV_API_KEY=your_moov_api_key
MOOV_MERCHANT_CODE=your_merchant_code

# Webhook secret (pour vérifier les callbacks des opérateurs)
WEBHOOK_SECRET=your_webhook_secret
