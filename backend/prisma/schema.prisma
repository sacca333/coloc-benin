generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum TypeCompte {
  ETUDIANT
  PROPRIETAIRE
  ADMIN
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  EN_ATTENTE
  ECHEC
}

enum OperateurPaiement {
  MOMO
  CCASH
  MOOV_MONEY
}

enum TypeAnnonce {
  LOGEMENT_DISPONIBLE
  PLACE_EN_COLOCATION
}

enum StatutAnnonce {
  ACTIVE
  INACTIVE
  MODEREE
  SUPPRIMEE
}

enum StatutColocation {
  ACTIVE
  EN_ATTENTE
  FERMEE
}

enum StatutColocataire {
  ACTIF
  EN_ATTENTE
  PARTI
}

