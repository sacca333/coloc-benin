generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeCompte {
  ETUDIANT
  AUTRE
  ADMIN
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  EN_ATTENTE
  ECHEC
}

enum OperateurPaiement {
  MOMO
  CCASH
  MOOV_MONEY
  FEDAPAY
}

enum TypeAnnonce {
  LOGEMENT_DISPONIBLE
  PLACE_EN_COLOCATION
}

enum StatutAnnonce {
  ACTIVE
  INACTIVE
  MODEREE
  SUPPRIMEE
  COMPLET
}

enum StatutColocation {
  ACTIVE
  EN_ATTENTE
  FERMEE
}

enum StatutColocataire {
  ACTIF
  EN_ATTENTE
  PARTI
}

enum Sexe {
  HOMME
  FEMME
}

model Utilisateur {
  id                String              @id @default(uuid())
  nom               String
  prenom            String
  email             String              @unique
  telephone         String?
  motDePasse        String
  sexe              Sexe                @default(HOMME)
  ville             String?
  universite        String?
  filiere           String?
  niveau            String?
  typeCompte        TypeCompte          @default(ETUDIANT)
  profession        String?
  photo             String?
  emailVerifie      Boolean             @default(false)
  tokenVerifEmail   String?
  actif             Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  annonces          Annonce[]
  abonnements       Abonnement[]
  messagesEnvoyes   Message[]           @relation("Expediteur")
  messagesRecus     Message[]           @relation("Destinataire")
  colocataires      Colocataire[]
  notifications     Notification[]
  signalements      Signalement[]       @relation("Signaleur")
  sauvegardes       Sauvegarde[]
  blocagesEmis      Blocage[]           @relation("Bloqueur")
  blocagesRecus     Blocage[]           @relation("Bloque")
  demandesPostulees Demande[]           @relation("Requester")

  @@map("utilisateurs")
}

model Annonce {
  id              String        @id @default(uuid())
  proprietaireId  String
  proprietaire    Utilisateur   @relation(fields: [proprietaireId], references: [id])
  type            TypeAnnonce
  adresse         String?
  quartier        String?
  ville           String
  loyerTotal      Int
  nbPlaces        Int
  placesRestantes Int           @default(0)
  nbColocataires  Int?
  caution         Int?
  telephone       String?
  description     String?
  equipements     String[]
  photos          String[]
  statut          StatutAnnonce @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  colocation   Colocation?
  signalements Signalement[]
  sauvegardes  Sauvegarde[]
  demandes     Demande[]

  @@map("annonces")
}

model Colocation {
  id          String           @id @default(uuid())
  annonceId   String?          @unique
  annonce     Annonce?         @relation(fields: [annonceId], references: [id])
  nom         String
  adresse     String?
  ville       String
  loyerTotal  Int
  nbPlaces    Int
  description String?
  statut      StatutColocation @default(EN_ATTENTE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  colocataires Colocataire[]

  @@map("colocations")
}

model Colocataire {
  id            String            @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur       @relation(fields: [utilisateurId], references: [id])
  colocId       String
  colocation    Colocation        @relation(fields: [colocId], references: [id])
  partLoyer     Int?
  statut        StatutColocataire @default(EN_ATTENTE)
  loyerConfirme Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([utilisateurId, colocId])
  @@map("colocataires")
}

model Sauvegarde {
  id            String      @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  annonceId     String
  annonce       Annonce     @relation(fields: [annonceId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([utilisateurId, annonceId])
  @@map("sauvegardes")
}

model Blocage {
  id         String      @id @default(uuid())
  bloqueurId String
  bloqueur   Utilisateur @relation("Bloqueur", fields: [bloqueurId], references: [id])
  bloqueId   String
  bloque     Utilisateur @relation("Bloque", fields: [bloqueId], references: [id])
  createdAt  DateTime    @default(now())

  @@unique([bloqueurId, bloqueId])
  @@map("blocages")
}

model Demande {
  id                String      @id @default(uuid())
  annonceId         String
  annonce           Annonce     @relation(fields: [annonceId], references: [id])
  requesterId       String
  requester         Utilisateur @relation("Requester", fields: [requesterId], references: [id])
  message           String?
  statut            String      @default("PENDING")
  requesterConfirme Boolean     @default(false)
  auteurConfirme    Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([annonceId, requesterId])
  @@map("demandes")
}

model Abonnement {
  id            String            @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur       @relation(fields: [utilisateurId], references: [id])
  operateur     OperateurPaiement
  montant       Int               @default(300)
  referenceOp   String?
  statut        StatutAbonnement  @default(EN_ATTENTE)
  periodeDebut  DateTime?
  periodeFin    DateTime?
  datePaiement  DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("abonnements")
}

model Message {
  id             String      @id @default(uuid())
  expediteurId   String
  expediteur     Utilisateur @relation("Expediteur", fields: [expediteurId], references: [id])
  destinataireId String
  destinataire   Utilisateur @relation("Destinataire", fields: [destinataireId], references: [id])
  contenu        String
  media          String?
  lu             Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@map("messages")
}

model Notification {
  id            String      @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  type          String
  titre         String
  message       String
  data          Json?
  lu            Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("notifications")
}

model Signalement {
  id          String      @id @default(uuid())
  annonceId   String
  annonce     Annonce     @relation(fields: [annonceId], references: [id])
  signaleurId String
  signaleur   Utilisateur @relation("Signaleur", fields: [signaleurId], references: [id])
  raison      String
  details     String?
  statut      String      @default("EN_ATTENTE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([annonceId, signaleurId])
  @@map("signalements")
}

model Ville {
  id        String   @id @default(uuid())
  nom       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("villes")
}
